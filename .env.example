# 复制为 .env 后按需修改；docker compose 会自动读取根目录的 .env
# 数据库
MYSQL_ROOT_PASSWORD=root123456
DB_NAME=library
DB_USERNAME=library
DB_PASSWORD=library123
MYSQL_PORT=3306

# 后端
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# 生产环境务必替换，长度至少 32 字节
JWT_SECRET=docker-only-library-jwt-secret-key-change-in-prod
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 前端
FRONTEND_PORT=80
